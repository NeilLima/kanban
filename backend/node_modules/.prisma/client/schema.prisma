// Kanban Pro - Schema Prisma
// Convenções: ver DOCUMENTACAO_GERAL.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USUÁRIOS
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String?  @unique
  password  String
  avatar    String?
  role      String   @default("member") // member | admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile         Profile?
  projectMembers  ProjectMember[]
  assignedTasks   TaskAssignee[]
  comments        Comment[]
  attachments     Attachment[]
  activityLogs    TaskHistory[]
  notifications   Notification[]
  createdProjects Project[]       @relation("ProjectOwner")
  createdTasks    Task[]          @relation("TaskCreator")
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique
  firstName   String
  lastName    String
  countryIso2 String?
  stateIso2   String?
  city        String?
  birthDate   DateTime?
  gender      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// PROJETOS
// ============================================

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  color       String        @default("#3b82f6")
  icon        String?
  isFavorite  Boolean       @default(false)
  isArchived  Boolean       @default(false)
  order       Int           @default(0)
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner         User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members       ProjectMember[]
  columns       Column[]
  tasks         Task[]
  labels        Label[]
  notifications Notification[]

  @@index([ownerId])
}

model ProjectMember {
  id        String     @id @default(uuid())
  projectId String
  userId    String
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ============================================
// KANBAN (COLUNAS + TAREFAS)
// ============================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Column {
  id        String @id @default(uuid())
  name      String
  color     String @default("#3b82f6")
  projectId String
  order     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id            String       @id @default(uuid())
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  color         String       @default("#3b82f6")
  category      String?
  columnId      String
  projectId     String
  creatorId     String?
  startDate     DateTime?
  dueDate       DateTime?
  estimatedTime Int? // minutos
  spentTime     Int? // minutos
  progress      Int          @default(0) // 0-100
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  column         Column          @relation(fields: [columnId], references: [id], onDelete: Cascade)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator        User?           @relation("TaskCreator", fields: [creatorId], references: [id])
  assignees      TaskAssignee[]
  labels         TaskLabel[]
  comments       Comment[]
  checklistItems ChecklistItem[]
  attachments    Attachment[]
  history        TaskHistory[]
  notifications  Notification[]

  @@index([columnId])
  @@index([projectId])
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

// ============================================
// ETIQUETAS
// ============================================

model Label {
  id        String  @id @default(uuid())
  name      String
  color     String  @default("#3b82f6")
  projectId String?

  project Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskLabel[]

  @@unique([name, projectId])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
}

// ============================================
// CHECKLIST
// ============================================

model ChecklistItem {
  id        String   @id @default(uuid())
  taskId    String
  title     String
  isDone    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ============================================
// COMENTÁRIOS (com respostas)
// ============================================

model Comment {
  id        String   @id @default(uuid())
  content   String
  taskId    String
  authorId  String
  parentId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([taskId])
}

// ============================================
// ANEXOS
// ============================================

model Attachment {
  id           String   @id @default(uuid())
  taskId       String
  fileName     String
  mimeType     String
  size         Int
  storageKey   String // chave no storage (local ou GridFS)
  uploadedById String
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
}

// ============================================
// HISTÓRICO (auditoria de mudanças)
// ============================================

model TaskHistory {
  id        String   @id @default(uuid())
  taskId    String
  userId    String?
  field     String // campo alterado (ex: "status", "priority")
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([taskId])
}

// ============================================
// NOTIFICAÇÕES
// ============================================

enum NotificationType {
  TASK_ASSIGNED
  COMMENT
  DUE_DATE
  INVITE
  CHANGE
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String?
  taskId    String?
  projectId String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
