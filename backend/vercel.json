{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "installCommand": "npm install --include=dev && npx prisma generate",
  "buildCommand": "./node_modules/.bin/nest build"
}